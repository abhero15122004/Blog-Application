# MongoDB Connection String (Required)
# If running MongoDB locally:
MONGODB_URI=mongodb://localhost:27017/blogdb
# Or if using MongoDB Atlas, replace with your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/blogdb

# Email Configuration (Optional - for sending emails/notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# OAuth2 Credentials (Optional - only required if you use social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS and Redirects (Default is set to match the frontend local port)
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
